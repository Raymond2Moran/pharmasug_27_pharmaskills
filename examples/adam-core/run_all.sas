/* Start SAS with the repository as working directory, or define PROJECT_ROOT
   before %INCLUDE. New run directory per invocation; raw inputs are never used.
   Only Base SAS 9.4 is required. See README.md for validation status. */
%macro setup;
  %global example_root run_root;
  %if not %symexist(project_root) %then %do;
    %global project_root;
    %let project_root=.;
  %end;
  filename exroot "&project_root/examples/adam-core";
  %let example_root=%sysfunc(pathname(exroot));
  data _null_;
    length parent fresh sdtm_path adam_path qc_path $1024 run_name $80;
    parent=cats(symget('example_root'),'/output');
    if not fileexist(parent) then parent=dcreate('output',symget('example_root'));
    if missing(parent) then do; put 'ERROR: Cannot create output directory.'; abort cancel; end;
    run_name=cats('run_',put(datetime(),hex16.),'_',symget('sysjobid'));
    fresh=dcreate(run_name,parent);
    if missing(fresh) then do; put 'ERROR: Cannot create fresh run directory.'; abort cancel; end;
    sdtm_path=dcreate('sdtm',fresh);
    adam_path=dcreate('adam',fresh);
    qc_path=dcreate('qc',fresh);
    if missing(sdtm_path) or missing(adam_path) or missing(qc_path) then do;
      put 'ERROR: Cannot create data libraries.'; abort cancel;
    end;
    call symputx('run_root',fresh,'g');
  run;
  %put NOTE: Output directory &run_root;
%mend;
%setup;
filename runlog "&run_root/run.log";
proc printto log=runlog new; run;
options nosource nosource2 nomprint nomlogic nosymbolgen;
%put NOTE: Runtime &sysvlong4;
ods listing file="&run_root/qc.lst";
libname sdtm "&run_root/sdtm";
libname adam "&run_root/adam";
libname qc "&run_root/qc";
%include "&example_root/helpers.sas";
%include "&example_root/source.sas";
%stop_if_errors(source_fixture);
/* Fixture source becomes read-only before any derivation. */
libname sdtm clear;
libname sdtm "&run_root/sdtm" access=readonly;
%include "&example_root/qc/expected.sas";
%stop_if_errors(expected_fixture);
%include "&example_root/programs/adsl.sas";
%include "&example_root/qc/check_adsl.sas";
%stop_if_errors(adsl_gate);
%include "&example_root/programs/bds_common.sas";
%include "&example_root/programs/adlb.sas";
%include "&example_root/programs/advs.sas";
%include "&example_root/programs/adae.sas";
%include "&example_root/programs/adcm.sas";
%include "&example_root/qc/check_children.sas";
%include "&example_root/qc/check_metadata.sas";
%stop_if_errors(final_checks);
%put NOTE: Fixture comparisons completed. Log review and independent review remain required.;
ods listing close;
ods listing;
proc printto; run;
%put NOTE: Review &run_root/run.log and &run_root/qc.lst;
